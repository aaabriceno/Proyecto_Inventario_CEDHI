# Variables locales para levantar Inventario CEDHI con Docker Compose.
# Copiar este archivo como `.env` antes de ejecutar Docker:
#   cp .env.example .env

# La app inventario_cedhi es v15; NO cambiar a v16 (rompe compatibilidad).
ERPNEXT_VERSION=v15.99.1

# Solo para desarrollo local. Cambiar si se usa en un entorno compartido.
DB_PASSWORD=admin

# Sitio que crea el servicio create-site la primera vez (y password del admin).
SITE_NAME=inventario.localhost
ADMIN_PASSWORD=admin

DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# Debe coincidir con SITE_NAME para que nginx resuelva el sitio por host.
FRAPPE_SITE_NAME_HEADER=inventario.localhost

RESTART_POLICY=unless-stopped
